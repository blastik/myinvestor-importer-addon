{
  "name": "myinvestor-importer-addon",
  "version": "1.4.0",
  "description": "Import MyInvestor and Inversis account exports into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "author": "blastik",
  "license": "MIT",
  "homepage": "https://github.com/blastik/myinvestor-importer-addon",
  "repository": {
    "type": "git",
    "url": "https://github.com/blastik/myinvestor-importer-addon.git"
  },
  "keywords": [
    "wealthfolio",
    "addon",
    "myinvestor",
    "inversis",
    "importer"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "bundle": "pnpm build && zip dist/myinvestor-importer-addon.zip manifest.json dist/addon.js README.md",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@wealthfolio/addon-dev-tools": "^3.9.0",
    "@wealthfolio/addon-sdk": "^3.9.0",
    "@wealthfolio/ui": "^3.9.0",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist/",
    "manifest.json",
    "README.md"
  ]
}
